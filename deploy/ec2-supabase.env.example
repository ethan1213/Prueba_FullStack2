# Copiar solo a /opt/syncpass/.env en EC2; no publicar valores reales.
# Supabase > Connect > Session pooler. Convertir la URI postgres a JDBC y exigir TLS.
DATABASE_URL=jdbc:postgresql://YOUR-POOLER.supabase.com:5432/postgres?sslmode=require&currentSchema=syncpass
DATABASE_USER=postgres.YOUR_PROJECT_REF
DATABASE_PASSWORD=replace-with-supabase-database-password

COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/USER_POOL_ID
COGNITO_CLIENT_ID=PUBLIC_APP_CLIENT_ID
CORS_ORIGINS=http://localhost:3000,https://YOUR-VERCEL-PROJECT.vercel.app

# Recalcular al reiniciar EC2 si cambia su IPv4 publica.
API_DOMAIN=api.YOUR-PUBLIC-IP.nip.io
ACME_EMAIL=your-email@example.com
