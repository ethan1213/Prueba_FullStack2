{
  "info": {
    "name": "SyncPass - EC2, Cognito y Supabase",
    "description": "Demostracion del JAR Spring Boot en EC2 con Supabase PostgreSQL y Cognito. El callback OAuth de Postman ya esta registrado en Cognito. Definir nuevo_usuario, nuevo_correo, nuevo_apodo, nueva_clave y codigo_verificacion como variables locales de Postman antes de probar el registro.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {"key": "grant_type", "value": "authorization_code", "type": "string"},
      {"key": "authUrl", "value": "{{cognito_domain}}/oauth2/authorize", "type": "string"},
      {"key": "accessTokenUrl", "value": "{{cognito_domain}}/oauth2/token", "type": "string"},
      {"key": "clientId", "value": "{{cognito_client_id}}", "type": "string"},
      {"key": "clientSecret", "value": "", "type": "string"},
      {"key": "callbackUrl", "value": "https://oauth.pstmn.io/v1/callback", "type": "string"},
      {"key": "scope", "value": "openid email", "type": "string"},
      {"key": "usePkce", "value": true, "type": "boolean"},
      {"key": "tokenName", "value": "SyncPass Cognito", "type": "string"}
    ]
  },
  "variable": [
    {"key": "base_url", "value": "https://hluamat8vg.execute-api.us-east-1.amazonaws.com"},
    {"key": "cognito_domain", "value": "https://us-east-12c9bbmkgd.auth.us-east-1.amazoncognito.com"},
    {"key": "cognito_client_id", "value": "677bhbj1qg892bmlk2pr1h6had"},
    {"key": "evento_id", "value": "1"}
  ],
  "item": [
    {
      "name": "00A Registrar usuario nuevo en Cognito",
      "request": {
        "auth": {"type": "noauth"},
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/x-amz-json-1.1"},
          {"key": "X-Amz-Target", "value": "AWSCognitoIdentityProviderService.SignUp"}
        ],
        "body": {"mode": "raw", "raw": "{\"ClientId\":\"{{cognito_client_id}}\",\"Username\":\"{{nuevo_usuario}}\",\"Password\":\"{{nueva_clave}}\",\"UserAttributes\":[{\"Name\":\"email\",\"Value\":\"{{nuevo_correo}}\"},{\"Name\":\"nickname\",\"Value\":\"{{nuevo_apodo}}\"}]}"},
        "url": "https://cognito-idp.us-east-1.amazonaws.com/"
      },
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Registro solicitado', function () { pm.response.to.have.status(200); });"], "type": "text/javascript"}}]
    },
    {
      "name": "00B Confirmar codigo recibido por correo",
      "request": {
        "auth": {"type": "noauth"},
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/x-amz-json-1.1"},
          {"key": "X-Amz-Target", "value": "AWSCognitoIdentityProviderService.ConfirmSignUp"}
        ],
        "body": {"mode": "raw", "raw": "{\"ClientId\":\"{{cognito_client_id}}\",\"Username\":\"{{nuevo_usuario}}\",\"ConfirmationCode\":\"{{codigo_verificacion}}\"}"},
        "url": "https://cognito-idp.us-east-1.amazonaws.com/"
      },
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Cuenta confirmada', function () { pm.response.to.have.status(200); });"], "type": "text/javascript"}}]
    },
    {
      "name": "01 Salud del JAR en EC2",
      "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{base_url}}/actuator/health"},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('JAR operativo', function () { pm.response.to.have.status(200); });", "pm.test('Spring Boot UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"], "type": "text/javascript"}}]
    },
    {
      "name": "02 Talleres publicos desde Supabase",
      "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{base_url}}/api/eventos"},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Respuesta desde la base', function () { pm.response.to.have.status(200); });", "pm.test('Lista JSON', function () { pm.expect(pm.response.json()).to.be.an('array'); });"], "type": "text/javascript"}}]
    },
    {
      "name": "03 Ruta protegida sin token",
      "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{base_url}}/api/me"},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Requiere iniciar sesion', function () { pm.response.to.have.status(401); });"], "type": "text/javascript"}}]
    },
    {
      "name": "04 Mi perfil con Cognito",
      "request": {"method": "GET", "url": "{{base_url}}/api/me"},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Token de acceso aceptado', function () { pm.response.to.have.status(200); });", "pm.test('Cognito entrega sub y roles', function () { const body=pm.response.json(); pm.expect(body.sub).to.be.a('string'); pm.expect(body.roles).to.be.an('array'); });"], "type": "text/javascript"}}]
    },
    {
      "name": "05 Crear taller como administrador",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"title\": \"Taller de prueba Postman\",\n  \"descripcion\": \"Registro de demostracion academica\",\n  \"area\": \"Tecnologia\",\n  \"unidadVecinal\": \"Unidad Vecinal 1\",\n  \"comuna\": \"Santiago\",\n  \"direccion\": \"Sala de pruebas\",\n  \"fechaHora\": \"2026-11-01T10:00:00\",\n  \"docenteLider\": \"Docente de prueba\",\n  \"cuposMaximos\": 25\n}"},
        "url": "{{base_url}}/api/eventos"
      },
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Creado en Supabase', function () { pm.response.to.have.status(201); });", "if (pm.response.code === 201) pm.collectionVariables.set('evento_id', pm.response.json().id);"], "type": "text/javascript"}}]
    },
    {
      "name": "06 Leer taller creado",
      "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{base_url}}/api/eventos/{{evento_id}}"},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Taller persistido', function () { pm.response.to.have.status(200); });"], "type": "text/javascript"}}]
    }
  ]
}
